{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openDataAgent:schemas_api/interroger_ressource.reponse",
  "title": "Reponse de l'API tabulaire data.gouv.fr /api/resources/{rid}/data/",
  "description": "Schema de validation de la charge utile brute retournee par l'API tabulaire, avant tout traitement.",
  "type": "object",
  "properties": {
    "data": {
      "type": "array",
      "description": "Lignes de la page courante ; chaque ligne est un objet colonne -> valeur.",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "links": {
      "type": ["object", "null"],
      "description": "Liens de pagination et documentation.",
      "additionalProperties": true
    },
    "meta": {
      "type": "object",
      "properties": {
        "page": { "type": "integer", "minimum": 1, "description": "Numero de la page courante." },
        "page_size": { "type": "integer", "minimum": 1, "description": "Taille de page effective." },
        "total": { "type": "integer", "minimum": 0, "description": "Nombre total de lignes de la ressource." }
      },
      "required": ["page", "page_size", "total"],
      "additionalProperties": true
    }
  },
  "required": ["data", "meta"],
  "additionalProperties": true
}
